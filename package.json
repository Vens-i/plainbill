{
  "name": "plainbill",
  "private": true,
  "description": "Clear, visual patient bills for small independent medical practices.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @plainbill/api --filter @plainbill/web dev",
    "start": "pnpm --filter @plainbill/seed seed --if-empty && pnpm --filter @plainbill/api start",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @plainbill/seed seed",
    "seed:generate": "pnpm --filter @plainbill/seed generate",
    "simulate:payment": "pnpm --filter @plainbill/api simulate:payment",
    "check:license": "pnpm --filter @plainbill/web check:license",
    "ai:record": "pnpm --filter @plainbill/seed ai:record",
    "paypal:webhook": "pnpm --filter @plainbill/api paypal:webhook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "packageExtensions": {
      "@paypal/paypal-server-sdk@1": {
        "dependencies": {
          "tslib": "^2.5.0"
        }
      }
    }
  }
}
