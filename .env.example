# Plainbill environment variables.
# Copy to `.env` at the repo root (gitignored) and fill in. Both the API and the
# web app (Vite, via envDir) read this one file. Only VITE_* values reach the browser.

# ── AI (packages/ai) ──────────────────────────────────────────────────────────
# Anthropic API key for EOB extraction, patient message drafting, Q&A and
# "AI suggests". Server-side only. Not used until Phase 2.
ANTHROPIC_API_KEY=
# Model id used by packages/ai, e.g. claude-sonnet-5-5 or claude-opus-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── PayPal (sandbox Merchant app) ─────────────────────────────────────────────
# REST app credentials from developer.paypal.com → Apps & Credentials (sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live". Keep sandbox for the hackathon.
PAYPAL_ENV=sandbox
# Webhook id from the sandbox app's webhook config; used to verify signatures.
PAYPAL_WEBHOOK_ID=
# Same client id as PAYPAL_CLIENT_ID, exposed to the browser for the JS SDK buttons.
VITE_PAYPAL_CLIENT_ID=

# ── AG Grid ───────────────────────────────────────────────────────────────────
# AG Grid Enterprise license key. Without it the grid runs in trial mode
# (watermark + console warning). Check a key with `pnpm check:license`.
VITE_AG_GRID_LICENSE_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key for patient bill emails. Not used until a later phase.
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL used to build patient pay links in emails.
APP_BASE_URL=http://localhost:5173

# ── Optional / local dev ──────────────────────────────────────────────────────
# API port in development (the Vite dev server proxies /api to it). In production
# the API listens on PORT, which the host (e.g. Render) provides.
API_PORT=3001
# SQLite file path, relative to the repo root.
DATABASE_PATH=apps/api/data/plainbill.db
# Pin "today" so aging and days-out match the demo script. Leave empty to use
# the real date. The seed data assumes 2026-10-10.
DEMO_TODAY=2026-10-10
