# Plainbill environment variables.
# Copy to `.env` at the repo root (gitignored) and fill in. Both the API and the
# web app (Vite, via envDir) read this one file. Only VITE_* values reach the browser.

# ── AI (packages/ai) ──────────────────────────────────────────────────────────
# Anthropic API key for EOB extraction and patient message drafting (later: Q&A and
# "AI suggests"). Server-side only. Without it, the API uses recorded EOB extractions and
# template messages.
ANTHROPIC_API_KEY=
# Model id used by packages/ai. claude-opus-5-5 is the recommended default;
# claude-sonnet-5-5 costs about half as much.
ANTHROPIC_MODEL=claude-opus-5-5
# How EOB PDFs are read when a key is set: auto (replay a recording when one exists for the
# exact PDF — the seed's sample EOBs — else read live), live, or recorded.
AI_EOB_MODE=auto
# Recorded extractions (written by `pnpm ai:record`), relative to the repo root.
EOB_RECORDINGS_DIR=seed/data/eob-recordings

# ── PayPal (sandbox Merchant app) ─────────────────────────────────────────────
# REST app credentials from developer.paypal.com → Apps & Credentials (sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live".
PAYPAL_ENV=sandbox
# Webhook id from the sandbox app's webhook config (needs a public HTTPS URL ending in
# /api/webhooks/paypal). Every webhook is verified with PayPal before it's trusted; without
# this id, webhooks are refused and the reconciliation poll below picks payments up instead.
PAYPAL_WEBHOOK_ID=
# Seconds between polls of open PayPal invoices and payment plans (catches payments made on
# PayPal's own invoice page, and anything a webhook missed). 0 turns polling off. Default 20.
PAYPAL_SYNC_SECONDS=20
# Optional. The patient page gets the (public) PAYPAL_CLIENT_ID from the API along with the
# bill, so the browser SDK always matches the server's PayPal app. Kept for tooling.
VITE_PAYPAL_CLIENT_ID=

# ── AG Grid ───────────────────────────────────────────────────────────────────
# AG Grid Enterprise license key. Without it the grid runs in trial mode
# (watermark + console warning). Check a key with `pnpm check:license`.
VITE_AG_GRID_LICENSE_KEY=

# AG Studio licence key (Practice insights, /insights). A separate product from the grid
# key. Without it every feature still works, with a watermark and a console notice; ask
# info@ag-grid.com for a trial key.
VITE_AG_STUDIO_LICENSE_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key for patient bill emails. Without it, emails are kept in the outbox and shown
# at /email-preview/:balanceId (nothing is delivered).
RESEND_API_KEY=
# Sender. Resend's shared onboarding@resend.dev address only delivers to your own Resend
# account email; use a verified domain to send anywhere else.
EMAIL_FROM=Harborview Family Medicine <onboarding@resend.dev>
# Testing: when set, every patient email goes to this address instead of the (fictional)
# one on file. Set it to your own inbox to see the emails.
EMAIL_TO_OVERRIDE=

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL used to build patient pay links in emails. Session cookies are marked
# Secure when this is https.
APP_BASE_URL=http://localhost:5173
# Signs patient-page sessions (after last name + DOB). Any long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. When empty, a
# random secret is generated at startup and sessions end on restart.
SESSION_SECRET=

# ── Optional / local dev ──────────────────────────────────────────────────────
# API port in development (the Vite dev server proxies /api to it). In production
# the API listens on PORT, which the host (e.g. Render) provides.
API_PORT=3001
# SQLite file path, relative to the repo root.
DATABASE_PATH=apps/api/data/plainbill.db
# Pin "today" so aging and days-out match the sample data. Leave empty to use
# the real date. The seed data assumes 2026-10-10.
DEMO_TODAY=2026-10-10
