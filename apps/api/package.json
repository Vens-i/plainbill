{
  "name": "@plainbill/api",
  "version": "0.1.0",
  "private": true,
  "description": "Plainbill API: Fastify + SQLite (Drizzle) + Server-Sent Events.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "simulate:payment": "tsx scripts/simulate-payment.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@plainbill/core": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "@fastify/multipart": "^10.1.3",
    "@plainbill/ai": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11"
  }
}
